# Settings are read from the environment only. Copy to .env and load it with
# `uv run --env-file .env gex-dashboard`, or export the variables. An unset or
# empty value means the default shown.

# Chain provider: synthetic (the seeded demo market) or convexvalue
GEX_PROVIDER=synthetic

# Comma-separated symbols offered in the sidebar (the index-regime badge compares them)
GEX_SYMBOLS=SPY,SPX,QQQ

# Clock: system (wall clock), fixed (stopped at GEX_CLOCK_START) or replay (loops
# one session from GEX_CLOCK_START). Default: replay for synthetic, system otherwise.
# GEX_CLOCK=replay

# ISO datetime for the fixed and replay clocks; without an offset it is New York
# time. Default: 09:30 New York time (the open) on the latest weekday.
# GEX_CLOCK_START=2026-10-19T11:00

# Replay speed multiplier (2 = two market minutes per real minute)
GEX_CLOCK_SPEED=1

# Strikes kept, as a fraction of spot either side (0.10 = within 10%); 0.02 to 0.25,
# the range of the sidebar's strike-range slider
GEX_STRIKE_RANGE=0.10

# Annual risk-free rate for the synthetic chain and for repricing gamma (gamma flip)
GEX_RISK_FREE_RATE=0.04

# Seed for the synthetic market; the same seed and clock time give the same chain
GEX_SYNTHETIC_SEED=0

# ConvexValue login, needed only when GEX_PROVIDER=convexvalue (requires convexlib;
# see the README). Placeholders: use your own account.
CONVEX_USER=
CONVEX_PASSWORD=
